classDiagram
    class Owner {
        -String ownerName
        -int availableMinutes
        -Dict preferences
        -List~Pet~ pets
        +register()
        +setAvailableMinutes(minutes: int)
        +addPreference(key: String, value: String)
        +addPet(pet: Pet)
        +getPets() List~Pet~
    }

    class Pet {
        -String petId
        -String name
        -String species
        -HealthCondition healthCondition
        +addTask(task: Task)
        +removeTask(taskId: String)
        +getTasks() List~Task~
    }

    class Task {
        -String taskId
        -String name
        -TaskType taskType
        -int durationMinutes
        -Priority priority
        -String preferredTime
        -boolean recurring
        -Pet pet
        +markDone()
        +updatePriority(priority: Priority)
    }

    class DailyPlan {
        -String planId
        -Date planDate
        -Pet pet
        -Owner owner
        -List~Task~ scheduledTasks
        -List~Task~ skippedTasks
        -Dict~String, String~ reasoning
        +generate(pet: Pet, owner: Owner)
        -sortByPriority(tasks: List~Task~) List~Task~
        -fitsInTime(task: Task, remainingMinutes: int) boolean
        +addTask(task: Task, reason: String)
        +skipTask(task: Task, reason: String)
        +getTotalMinutes() int
        +explain() String
    }

    class HealthCondition {
        <<enumeration>>
        HEALTHY
        SICK
        RECOVERING
        SENIOR
    }

    class TaskType {
        <<enumeration>>
        WALK
        FEEDING
        MEDICATION
        ENRICHMENT
        GROOMING
        OTHER
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    Owner "1" -- "1..*" Pet : owns
    Pet "1" -- "*" Task : has
    DailyPlan "1" --> "1" Owner : for
    DailyPlan "1" --> "1" Pet : for
    DailyPlan "1" *-- "0..*" Task : includes
    Pet ..> HealthCondition : uses
    Task ..> TaskType : uses
    Task ..> Priority : uses
